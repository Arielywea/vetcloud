{
  "framework": null,
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "memory": 256
    }
  },
  "headers": [
    {
      "source": "/f/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": "/api"
    },
    {
      "source": "/items/(.*)",
      "destination": "/api"
    },
    {
      "source": "/appointments/(.*)",
      "destination": "/api"
    },
    {
      "source": "/vital-measurements(.*)",
      "destination": "/api"
    },
    {
      "source": "/payments(.*)",
      "destination": "/api"
    },
    {
      "source": "/reports/(.*)",
      "destination": "/api"
    },
    {
      "source": "/stats/(.*)",
      "destination": "/api"
    },
    {
      "source": "/search(.*)",
      "destination": "/api"
    },
    {
      "source": "/public/(.*)",
      "destination": "/api"
    },
    {
      "source": "/files",
      "destination": "/api"
    },
    {
      "source": "/assistant",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
