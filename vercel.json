{
  "framework": null,
  "buildCommand": "npx expo export --platform web && node scripts/inject-pwa.js",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "memory": 256
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/f/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": "/api"
    },
    {
      "source": "/items/(.*)",
      "destination": "/api"
    },
    {
      "source": "/appointments/(.*)",
      "destination": "/api"
    },
    {
      "source": "/vital-measurements(.*)",
      "destination": "/api"
    },
    {
      "source": "/payments(.*)",
      "destination": "/api"
    },
    {
      "source": "/reports/(.*)",
      "destination": "/api"
    },
    {
      "source": "/account/(.*)",
      "destination": "/api"
    },
    {
      "source": "/stats/(.*)",
      "destination": "/api"
    },
    {
      "source": "/search(.*)",
      "destination": "/api"
    },
    {
      "source": "/public/(.*)",
      "destination": "/api"
    },
    {
      "source": "/files",
      "destination": "/api"
    },
    {
      "source": "/assistant",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
